{
  "name": "@codapult/cli",
  "version": "0.1.4",
  "description": "Codapult CLI — manage, update, and diagnose your Codapult SaaS project",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codapult": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc",
    "release": "release-it"
  },
  "keywords": [
    "codapult",
    "saas",
    "boilerplate",
    "cli",
    "nextjs"
  ],
  "homepage": "https://codapult.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/codapult/codapult-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@js-toolkit/config-utils": "^1.0.1",
    "@js-toolkit/eslint-config": "^1.1.4",
    "@js-toolkit/prettier-config": "^1.0.1",
    "@js-toolkit/tsconfig": "^1.0.1",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/node": "^25.5.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "release-it": "^20.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.12",
      "@hono/node-server": ">=1.19.13"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@release-it/conventional-changelog>release-it": ">=18"
      }
    }
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
