{
  "name": "@codapult/cli",
  "version": "0.16.1",
  "description": "Codapult CLI — manage, update, and diagnose your Codapult SaaS project",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "bin": {
    "codapult": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc",
    "release": "release-it"
  },
  "keywords": [
    "codapult",
    "saas",
    "boilerplate",
    "cli",
    "nextjs"
  ],
  "homepage": "https://codapult.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/codapult/codapult-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@js-toolkit/config-utils": "^1.0.1",
    "@js-toolkit/eslint-config": "^1.1.4",
    "@js-toolkit/prettier-config": "^1.0.1",
    "@js-toolkit/tsconfig": "^1.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
