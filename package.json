{
  "name": "@codapult/cli",
  "version": "0.1.0",
  "description": "Codapult CLI — manage, update, and diagnose your Codapult SaaS project",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codapult": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "codapult",
    "saas",
    "boilerplate",
    "cli",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AstronautSaaS/codapult-cli.git"
  },
  "homepage": "https://codapult.dev",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@js-toolkit/config-utils": "^1.0.1",
    "@js-toolkit/eslint-config": "^1.1.3",
    "@js-toolkit/prettier-config": "^1.0.1",
    "@js-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.1"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  }
}
