{
  "name": "@codapult/cli",
  "version": "0.15.0",
  "description": "Codapult CLI — manage, update, and diagnose your Codapult SaaS project",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "bin": {
    "codapult": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc",
    "release": "release-it"
  },
  "keywords": [
    "codapult",
    "saas",
    "boilerplate",
    "cli",
    "nextjs"
  ],
  "homepage": "https://codapult.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/codapult/codapult-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@js-toolkit/config-utils": "^1.0.1",
    "@js-toolkit/eslint-config": "^1.1.4",
    "@js-toolkit/prettier-config": "^1.0.1",
    "@js-toolkit/tsconfig": "^1.0.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "release-it": "^21.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
